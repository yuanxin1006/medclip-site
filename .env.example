NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Edge Function server-only configuration. Never prefix these with NEXT_PUBLIC_.
MEDCLIP_CREDENTIAL_ENCRYPTION_KEY=
MEDCLIP_ALLOWED_ORIGINS=

# Static resource root containing medclip-asr/. Empty uses same-origin /medclip-asr/ in development.
# If model files are served separately in development, use a loopback URL. Production ASR requires an HTTPS asset root.
NEXT_PUBLIC_MEDCLIP_ASSET_BASE_URL=

